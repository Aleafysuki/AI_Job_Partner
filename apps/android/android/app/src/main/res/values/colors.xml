<?xml version="1.0" encoding="utf-8"?>
<!--
  Metro 色板（Android 原生侧）。

  为什么不直接在各处写十六进制：Web 那一侧的 Metro 令牌定义在
  apps/desktop/src/renderer/src/styles-metro.css 里。原生侧只有少数几个地方
  需要颜色（状态栏、启动图、图标底色、通知），集中在这里，
  与 styles-metro.css 里的 Metro 令牌一一对应，改一处能一眼看到另一处。

  ⚠ 写这份注释时踩过一次：XML 注释里**不允许出现连续两个连字符**，
  而 CSS 自定义属性的前缀正好就是那两个字符。写了会让整个文件解析失败，
  报 "not well-formed (invalid token)"，且报错行号指向注释那一行 ——
  看起来像配色写错了，实际是注释语法问题。
  所以下面提到变量名时一律省略前缀。
  这也是没有 Android SDK 时唯一能做的原生侧校验：XML 良构性检查。

  颜色写成 #AARRGGBB，注意这不是 Web 里的 #RRGGBB。

  ⚠ 这里刻意写**字面量**，而不是用同名颜色资源互相引用：
  aapt2 对 color 元素内的资源引用在不同版本上行为不一致，
  而这个文件无法在本机编译验证（没有 Android SDK），
  所以选语法上最没有争议的写法。同名同值，不影响任何引用方。
-->
<resources>
    <!-- 与 styles-metro.css 的 metro-accent / metro-accent-dark 同值一致 -->
    <color name="metro_blue">#FF0050EF</color>
    <color name="metro_blue_dark">#FF0041C2</color>
    <color name="metro_ink">#FF1C2024</color>
    <color name="metro_white">#FFFFFFFF</color>

    <!--
      这三个名字原本由 capacitor-android 库提供，应用主题 styles.xml 引用它们。
      在这里重定义（同值字面量）即可把整个原生外壳换成 Metro 配色，
      不用动主题结构。
    -->
    <color name="colorPrimary">#FF0050EF</color>
    <color name="colorPrimaryDark">#FF0041C2</color>
    <color name="colorAccent">#FF0050EF</color>
</resources>
