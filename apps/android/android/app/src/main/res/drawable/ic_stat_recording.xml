<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标（静默模式的前台服务用）。

  必须是**纯白剪影 + 透明背景**：Android 的状态栏会把小图标当作遮罩来染色，
  带颜色的图标会变成一块实心方块。
  所以这里只有白色路径，形如「录音」——一个实心圆外套一圈环。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M12,3 a9,9 0 1,1 0,18 a9,9 0 1,1 0,-18 z" />

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8 a4,4 0 1,1 0,8 a4,4 0 1,1 0,-8 z" />
</vector>
