{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/multi-dimension-fit-report/schemas/report.schema.json",
  "title": "多维度适配度分析 · 报告契约",
  "description": "report.json 的唯一权威结构。所有渲染（HTML / Word）必须由它生成，不得在渲染阶段新增结论。",
  "type": "object",
  "required": ["schema_version", "generated_at", "domain", "meta", "evidence", "dimensions", "synthesis"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "domain": { "type": "string", "default": "job-position" },
    "meta": {
      "type": "object",
      "required": ["title", "anonymized"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "default": "岗位深度分析报告" },
        "subject_alias": { "type": "string", "default": "当事人" },
        "counterparty_alias": { "type": "string", "default": "对方" },
        "opportunity_alias": { "type": "string", "default": "该岗位" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "anonymized": { "type": "boolean", "default": true },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "coverage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "transcript_chars": { "type": "integer", "minimum": 0 },
            "speakers": { "type": "array", "items": { "type": "string" } },
            "completeness": { "type": "string", "enum": ["full", "partial", "fragment"] }
          }
        }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } },
    "charts": { "$ref": "#/$defs/charts" },
    "synthesis": { "$ref": "#/$defs/synthesis" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },

  "$defs": {
    "basis": { "type": "string", "enum": ["stated", "inferred", "mixed"] },
    "basisLeaf": { "type": "string", "enum": ["stated", "inferred"] },
    "status": { "type": "string", "enum": ["ok", "partial", "insufficient_info"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "priority": { "type": "string", "enum": ["high", "medium", "low"] },
    "pressureLevel": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },

    "evidenceItem": {
      "type": "object",
      "required": ["id", "quote", "speaker", "type", "topic", "consistency"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]+$" },
        "quote": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string" },
        "type": { "type": "string", "enum": ["claim", "fact", "number", "promise", "evasion"] },
        "topic": { "type": "string", "enum": ["workload", "pay", "schedule", "content", "environment", "requirement", "other"] },
        "consistency": { "type": "string", "enum": ["unique", "conflicting"] },
        "note": { "type": "string" }
      }
    },

    "finding": {
      "type": "object",
      "required": ["text", "basis", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basisLeaf" },
        "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^E[0-9]+$" } }
      }
    },

    "question": {
      "type": "object",
      "required": ["text", "priority"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 4 },
        "priority": { "$ref": "#/$defs/priority" },
        "category": {
          "type": "string",
          "enum": ["workload_kpi", "pay_benefit", "time_shift", "environment_content", "org_position", "other"]
        },
        "targets": { "type": "string", "pattern": "^D([1-9]|1[0-2])$" }
      }
    },

    "computation": {
      "type": ["object", "null"],
      "required": ["formula", "inputs", "result"],
      "additionalProperties": false,
      "properties": {
        "formula": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object" },
        "result": { "type": "object" },
        "verdict": { "type": "string" }
      }
    },

    "dimension": {
      "type": "object",
      "required": ["id", "name", "status", "findings"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^D([1-9]|1[0-2])$" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "basis": { "$ref": "#/$defs/basis" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "extras": { "type": "object", "description": "各维度专属结构，键名见 prompts/stage2-analyze.md" },
        "computation": { "$ref": "#/$defs/computation" },
        "scores": {
          "type": "object",
          "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/score" }, { "$ref": "#/$defs/pressureLevel" }] }
        },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]+$" } }
      }
    },

    "charts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": { "$ref": "#/$defs/radarSeries" },
        "stress": { "$ref": "#/$defs/radarSeries" },
        "fit": { "$ref": "#/$defs/radarSeries" },
        "workload_time": { "$ref": "#/$defs/tableBlock" },
        "hourly_wage": { "$ref": "#/$defs/tableBlock" }
      }
    },

    "radarSeries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis"],
        "additionalProperties": false,
        "properties": {
          "axis": { "type": "string" },
          "value": { "$ref": "#/$defs/score" }
        }
      }
    },

    "tableBlock": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "formula": { "type": "string" },
        "rows": { "type": "array", "items": { "type": "object" } },
        "verdict": { "type": "string" }
      }
    },

    "synthesis": {
      "type": "object",
      "required": ["one_line", "tier", "verdict_paragraph", "boundary_statement"],
      "additionalProperties": false,
      "properties": {
        "one_line": { "type": "string", "maxLength": 120 },
        "tier": { "type": "string", "enum": ["consider", "caution", "mismatch", "insufficient"] },
        "verdict_paragraph": { "type": "string" },
        "highlights": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["text", "evidence_ids"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^E[0-9]+$" } }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["key", "label", "points"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "enum": ["A", "B", "C"] },
              "label": { "type": "string" },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "field": { "type": "string" },
                    "text": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "decision_table": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "conditions"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "enum": ["consider", "caution", "mismatch"] },
              "label": { "type": "string" },
              "conditions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "next_action": { "type": "string" },
        "boundary_statement": { "type": "string" }
      }
    }
  }
}
